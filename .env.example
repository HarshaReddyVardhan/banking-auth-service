# ===========================================
# Banking Auth Service Configuration
# ===========================================

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL with SSL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_auth
DB_USER=auth_service
DB_PASSWORD=your_secure_password_here
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (Sessions & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TLS=true
REDIS_DB=0

# JWT Configuration (RS256 with 3072-bit keys)
JWT_PRIVATE_KEY_PATH=/secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=banking-auth-service
JWT_AUDIENCE=banking-api

# JWT Key Rotation
JWT_KEY_ROTATION_DAYS=90
JWT_KEY_GRACE_PERIOD_DAYS=7

# Security Settings
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=12
PASSWORD_EXPIRY_DAYS=90
MAX_LOGIN_ATTEMPTS=7
LOCKOUT_DURATION_MS=900000

# Session Settings
MAX_CONCURRENT_SESSIONS=5
SESSION_EXPIRY_HOURS=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
EMAIL_RESEND_LIMIT_PER_EMAIL=3
EMAIL_RESEND_LIMIT_PER_IP=5
EMAIL_RESEND_WINDOW_HOURS=1

# MFA Settings
MFA_ISSUER=BankingApp
MFA_BACKUP_CODES_COUNT=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=banking-auth-service
KAFKA_SECURITY_TOPIC=security-events

# Email Service (configure with your provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=BankingApp <noreply@example.com>

# Breach Detection
HIBP_API_KEY=your_haveibeenpwned_api_key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Encryption Key (for sensitive field encryption)
FIELD_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
